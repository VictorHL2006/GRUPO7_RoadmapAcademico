# Copia este archivo a .env y completa los valores locales.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadmap_db
DB_USER=roadmap_user
DB_PASSWORD=CAMBIAR_POR_LA_CLAVE_LOCAL_DE_POSTGRES

# Reemplazar por una clave aleatoria de al menos 32 caracteres.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS

PRIVATE_KEY_PATH=keys/private.pem
PUBLIC_KEY_PATH=keys/public_key.pem
MALLA_PATH=data/malla.json
MAX_CREDITOS=22

# Orígenes para el backend API y la interfaz servida por Python.
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Contraseñas locales para las cuentas ficticias creadas por cargar_demo.py.
DEMO_ESTUDIANTE_PASSWORD=CAMBIAR_CLAVE_DEMO_ESTUDIANTE
DEMO_TUTOR_PASSWORD=CAMBIAR_CLAVE_DEMO_TUTOR
